<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_payment_split.SplitPaymentStatus">
        <section class="card border-0 shadow-sm mb-3 pos-payment-split-status-panel" t-if="showPanel">
            <div class="card-body p-3 d-flex flex-column gap-2">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold text-primary">
                        <i class="fa fa-scissors me-2" role="img"/>
                        Split in progress
                    </h6>
                    <span t-if="props.plan?.active" class="badge text-bg-primary rounded-pill" t-esc="progressLabel"/>
                </div>

                <div class="text-center rounded-3 border bg-view px-3 py-2">
                    <div class="small text-muted">Remaining</div>
                    <div class="fs-4 fw-bold" t-esc="props.formatCurrency(props.order.get_due())"/>
                    <div t-if="props.plan?.active" class="small text-muted mt-1">
                        This charge:
                        <strong class="text-success" t-esc="props.formatCurrency(currentCharge)"/>
                    </div>
                </div>

                <t t-if="showStop">
                    <p class="text-center mb-0 pos-payment-split-status">
                        <i class="fa fa-circle-o-notch fa-spin me-2" role="img"/>
                        Waiting for terminal
                    </p>
                    <button type="button" class="btn btn-danger w-100 py-2 fw-semibold" t-on-click="() => props.onStop()">
                        <i class="fa fa-stop me-2" role="img"/>
                        Stop
                    </button>
                </t>

                <t t-if="showStopped">
                    <p class="text-center small text-muted mb-0">Split stopped</p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger flex-fill py-2" t-on-click="() => props.onCancel()">
                            Cancel split
                        </button>
                        <button type="button" class="btn btn-primary flex-fill py-2" t-on-click="() => props.onRetry()">
                            Re-try
                        </button>
                    </div>
                </t>
            </div>
        </section>
    </t>

</templates>

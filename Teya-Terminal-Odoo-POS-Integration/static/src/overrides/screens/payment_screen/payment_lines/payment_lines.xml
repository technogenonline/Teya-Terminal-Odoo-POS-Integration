<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="teya_payment_terminal_integration.PaymentScreenPaymentLines"
       t-inherit="pos_payment_split.PaymentScreenPaymentLines"
       t-inherit-mode="extension">

        <!-- Selected line: show Cancel on the row (mobile-friendly) instead of only a spinner -->
        <xpath expr="//t[@t-elif=&quot;line.payment_status and ['waitingCard', 'waitingCapture'].includes(line.payment_status)&quot;]" position="replace">
            <t t-elif="line.payment_status and ['waitingCard', 'waitingCapture'].includes(line.payment_status)">
                <t t-if="canShowTaplinkLineCancel(line)">
                    <button type="button"
                        class="btn btn-outline-danger taplink-line-cancel-btn mx-2 px-3"
                        t-on-click.stop="() => this.cancelTaplinkPayment(line)"
                        t-att-title="taplinkCancelLabel()"
                        t-att-aria-label="taplinkCancelLabel()">
                        <i class="fa fa-times me-sm-1" role="img"/>
                        <span t-esc="taplinkCancelLabel()"/>
                    </button>
                </t>
                <t t-else="">
                    <div class="mx-2 px-3">
                        <i class="fa fa-circle-o-notch fa-spin" role="img"/>
                    </div>
                </t>
            </t>
        </xpath>

        <!-- waitingCard detail panel -->
        <xpath expr="//t[@t-elif=&quot;line.payment_status == 'waitingCard'&quot;]" position="replace">
            <t t-elif="line.payment_status == 'waitingCard'">
                <div class="electronic_status">
                    <t t-if="line.payment_method_id.use_payment_terminal === 'taplink'">
                        Waiting for Teya terminal
                    </t>
                    <t t-elif="line.payment_method_id.use_payment_terminal === 'dna'">
                        Waiting for DNA terminal
                    </t>
                    <t t-else="">
                        Waiting for card
                    </t>
                </div>
                <div class="taplink-epayment-actions">
                    <t t-if="line.payment_method_id.use_payment_terminal === 'taplink'">
                        <div class="button taplink-cancel-primary send_payment_cancel"
                            title="Cancel payment on Teya terminal"
                            t-on-click="() => this.cancelTaplinkPayment(line)">
                            <i class="fa fa-times me-2" role="img"/>
                            Cancel on terminal
                        </div>
                        <div t-if="canShowTerminalForceDone(line)"
                            class="button send_force_done"
                            title="Force Done (advanced PIN)"
                            t-on-click="() => this.props.sendForceDone(line)">
                            Force done
                        </div>
                    </t>
                    <t t-elif="line.payment_method_id.use_payment_terminal === 'dna'">
                        <i class="fa fa-circle-o-notch fa-spin" role="img" title="Waiting for terminal…"/>
                        <div t-if="canShowTerminalForceDone(line)"
                            class="button send_force_done"
                            title="Force Done (advanced PIN)"
                            t-on-click="() => this.props.sendForceDone(line)">
                            Force done
                        </div>
                        <div class="button send_payment_cancel"
                            title="Cancel Payment Request"
                            t-on-click="() => this.props.sendPaymentCancel(line)">
                            Cancel
                        </div>
                    </t>
                    <t t-else="">
                        <div t-if="canShowTerminalForceDone(line)"
                            class="button send_force_done" title="Force Done" t-on-click="() => this.props.sendForceDone(line)">
                            Force done
                        </div>
                        <div class="button send_payment_cancel" title="Cancel Payment Request" t-on-click="() => this.props.sendPaymentCancel(line)">
                            Cancel
                        </div>
                    </t>
                </div>
            </t>
        </xpath>

        <!-- Request sent / waiting for gateway -->
        <xpath expr="//t[@t-elif=&quot;['waiting', 'waitingCancel', 'waitingCapture'].includes(line.payment_status)&quot;]" position="replace">
            <t t-elif="['waiting', 'waitingCancel', 'waitingCapture'].includes(line.payment_status)">
                <div class="electronic_status">
                    <t t-if="line.payment_status === 'waitingCancel'">
                        Cancelling on terminal…
                    </t>
                    <t t-else="">
                        Request sent
                    </t>
                </div>
                <div class="taplink-epayment-actions">
                    <t t-if="isTaplinkLine(line) and line.payment_status === 'waiting'">
                        <div class="button taplink-cancel-primary send_payment_cancel"
                            title="Cancel payment on Teya terminal"
                            t-on-click="() => this.cancelTaplinkPayment(line)">
                            <i class="fa fa-times me-2" role="img"/>
                            Cancel on terminal
                        </div>
                        <div t-if="canShowTerminalForceDone(line)"
                            class="button send_force_done"
                            title="Force Done (advanced PIN)"
                            t-on-click="() => this.props.sendForceDone(line)">
                            Force done
                        </div>
                    </t>
                    <t t-else="">
                        <i class="fa fa-circle-o-notch fa-spin" role="img"/>
                        <div t-if="line.payment_status == 'waiting' and canShowTerminalForceDone(line)"
                            class="button send_force_done" title="Force Done" t-on-click="() => this.props.sendForceDone(line)">
                            Force done
                        </div>
                        <div t-if="line.payment_status == 'waitingCancel' and canShowTerminalForceDone(line)"
                            class="button send_force_done" title="Force Cancel" t-on-click="() => line.set_payment_status('retry')">
                            Force cancel
                        </div>
                    </t>
                </div>
            </t>
        </xpath>

        <!-- Unselected line: Teya in progress → Cancel instead of remove (pos_payment_split uses button) -->
        <xpath expr="//div[hasclass('paymentline') and hasclass('bg-view')]//button[hasclass('delete-button')]" position="replace">
            <t t-if="canShowTaplinkLineCancel(line)">
                <button type="button"
                    class="btn btn-outline-danger taplink-line-cancel-btn mx-2 px-3"
                    t-on-click.stop="() => this.cancelTaplinkPayment(line)"
                    t-att-title="taplinkCancelLabel()"
                    t-att-aria-label="taplinkCancelLabel()">
                    <i class="fa fa-times me-sm-1" role="img"/>
                    <span t-esc="taplinkCancelLabel()"/>
                </button>
            </t>
            <t t-else="">
                <button t-if="canRemovePaymentLine(line)"
                    class="delete-button btn btn-link mx-2 px-3"
                    t-on-click.stop="() => this.props.deleteLine(line.uuid)"
                    aria-label="Remove" title="Remove">
                    <i class="fa fa-times-circle text-danger fs-2" role="img"/>
                </button>
            </t>
        </xpath>

    </t>

</templates>

<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="teya_payment_terminal_integration.PaymentScreenDue"
       t-inherit="point_of_sale.PaymentScreenDue"
       t-inherit-mode="extension">
        <xpath expr="//section[hasclass('paymentlines-container')]" position="after">
            <TaplinkEqualSplitPanel
                t-if="!pos.config.enable_payment_split"
                order="currentOrder"
                formatCurrency.bind="env.utils.formatCurrency"
                splitCount="taplinkSplitUi.splitCount"
                useEqualSplit="taplinkSplitUi.useEqualSplit"
                onSplitCountChange.bind="onTaplinkSplitCountChange"
                taplinkPaymentMethods="taplinkPaymentMethods"
                plan="taplinkEqualSplitPlan"
                terminalInProgress="taplinkTerminalBusy"
                onPayTerminal.bind="startTaplinkEqualSplit"
                onPayCash.bind="payTaplinkSplitWithCash"
                onStop.bind="stopTaplinkEqualSplit"
                onCancelSplit.bind="cancelTaplinkEqualSplit"
                onRetrySplit.bind="retryTaplinkEqualSplit"
                onForceDone.bind="forceDoneTaplinkEqualSplit"
                hasCashMethod="hasCashPaymentMethod"/>
        </xpath>
    </t>

</templates>

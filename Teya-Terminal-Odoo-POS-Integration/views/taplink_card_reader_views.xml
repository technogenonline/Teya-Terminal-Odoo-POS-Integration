<odoo>
    <record id="taplink_card_reader_form" model="ir.ui.view">
        <field name="name">taplink.card.reader.form</field>
        <field name="model">taplink.card.reader</field>
        <field name="arch" type="xml">
            <form string="Card reader" edit="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Serial number" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <field name="reader_api_id"/>
                        <field name="reader_label"/>
                        <field name="outlet_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="taplink_card_reader_list" model="ir.ui.view">
        <field name="name">taplink.card.reader.list</field>
        <field name="model">taplink.card.reader</field>
        <field name="arch" type="xml">
            <list string="Card readers">
                <field name="name"/>
                <field name="reader_api_id"/>
                <field name="reader_label"/>
            </list>
        </field>
    </record>

    <record id="taplink_card_reader_action" model="ir.actions.act_window">
        <field name="name">Card readers</field>
        <field name="res_model">taplink.card.reader</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="taplink_readers_menu"
        name="Card readers"
        parent="taplink_root_menu"
        sequence="2"
        action="taplink_card_reader_action"
        groups="point_of_sale.group_pos_manager"/>
</odoo>

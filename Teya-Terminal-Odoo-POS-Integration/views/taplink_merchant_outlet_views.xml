<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="taplink_merchant_outlet_list" model="ir.ui.view">
        <field name="name">taplink.merchant.outlet.list</field>
        <field name="model">taplink.merchant.outlet</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="external_outlet_id"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="zipcode"/>
            </list>
        </field>
    </record>

    <record id="taplink_merchant_outlet_form" model="ir.ui.view">
        <field name="name">taplink.merchant.outlet.form</field>
        <field name="model">taplink.merchant.outlet</field>
        <field name="arch" type="xml">
            <form string="Merchant outlets" edit="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="external_outlet_id"/>
                        <field name="street_1"/>
                        <field name="street_2"/>
                        <field name="city"/>
                        <field name="zipcode"/>
                        <field name="country_id"/>
                        <field name="linked_payment_method_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="taplink_merchant_outlet_action" model="ir.actions.act_window">
        <field name="name">Merchant outlets</field>
        <field name="res_model">taplink.merchant.outlet</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="taplink_root_menu"
        name="Teya PosLink"
        parent="point_of_sale.menu_point_config_product"
        groups="point_of_sale.group_pos_manager"/>

    <menuitem
        id="taplink_outlets_menu"
        name="Outlets"
        parent="taplink_root_menu"
        sequence="1"
        action="taplink_merchant_outlet_action"
        groups="point_of_sale.group_pos_manager"/>
</odoo>

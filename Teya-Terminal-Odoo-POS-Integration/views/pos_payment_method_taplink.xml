<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="taplink_pos_payment_method_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.taplink</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
<xpath expr="//field[@name='payment_method_type']" position="attributes">
<attribute name="invisible">1</attribute>
</xpath>
<xpath expr="//field[@name='use_payment_terminal']" position="attributes">
<attribute name="invisible">0</attribute>
<attribute name="string">Use a Payment Terminal</attribute>
</xpath>
<xpath expr="//sheet" position="before">
<header>
    <button class="oe_highlight" name="action_taplink_sync_outlets" type="object">
        Sync outlets
    </button>
    <button name="action_taplink_device_authorize" string="Generate Token" class="oe_highlight" type="object" invisible="use_payment_terminal != 'taplink'"/>
</header>
</xpath>
<xpath expr="//field[@name='use_payment_terminal']" position="after">
<field name="taplink_runtime_mode" invisible="1"/>
<field name="taplink_access_token" invisible="1"/>
<field name="taplink_refresh_token" invisible="1"/>
<field name="taplink_outlet_id" invisible="use_payment_terminal != 'taplink'"/>
<field name="taplink_reader_id"
       invisible="use_payment_terminal != 'taplink'"
       options="{'no_create': True}"
       domain="[('outlet_id', '=', taplink_outlet_id)]"/>
</xpath>
    </field>        
    </record>
    </odoo>
        
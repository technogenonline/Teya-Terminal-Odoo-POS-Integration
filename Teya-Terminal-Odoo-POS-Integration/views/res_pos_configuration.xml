<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="taplink_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.taplink</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_terminals_section']" position="inside">
                <setting id="taplink_payment_terminal_setting" title="The transactions are processed by Teya." string="Teya" help="Accept payments with a Teya payment terminal">
                    <field name="module_teya_payment_terminal_integration"/>
                    <div class="content-group mt16" invisible="not module_teya_payment_terminal_integration">
                        <p class="text-muted mb-0">
                            Configure <strong>Store</strong> and <strong>Card reader</strong> on each Teya payment method
                            (Point of Sale → Configuration → Payment Methods).
                        </p>
                    </div>
                </setting>
                <setting id="teya_pos_terminal_force_done_setting"
                    string="Allow Force Done"
                    help="Show Force Done on stuck terminal payments. Requires an advanced employee PIN.">
                    <field name="pos_allow_terminal_force_done"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
